# Copy to .env — never commit the real thing.

# Experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=adaptive-fraud-lab

# Where the raw datasets land (PaySim / IEEE-CIS csv or parquet)
AFL_DATA_DIR=./data/raw
AFL_ARTIFACT_DIR=./artifacts

# Global determinism — overridden by config.yaml:seed when set
AFL_SEED=1337

# Serving
AFL_API_HOST=0.0.0.0
AFL_API_PORT=8000
AFL_API_URL=http://localhost:8000
